# Firebase web config (Project settings -> General -> Your apps -> SDK setup)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: set to "1" to force the bundled JSON data even when Firebase is configured
NEXT_PUBLIC_USE_LOCAL_DATA=0

# Server-only: full service-account JSON on one line, used by `npm run seed`
# (Firestore rules deny client writes, so seeding needs the Admin SDK)
FIREBASE_SERVICE_ACCOUNT=
